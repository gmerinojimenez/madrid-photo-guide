{
  "expo": {
    "name": "Madrid Photo Guide",
    "slug": "madrid-photo-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "madridphotoguide",
    "ios": {
      "bundleIdentifier": "com.gmj.madridphotoguide",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gmj.madridphotoguide",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "extra": {
      "revenuecat": {
        "iosApiKey": "REPLACE_WITH_REVENUECAT_IOS_API_KEY",
        "androidApiKey": "REPLACE_WITH_REVENUECAT_ANDROID_API_KEY",
        "entitlementId": "full_guide"
      }
    },
    "plugins": [
      "expo-router",
      "expo-maps",
      "expo-sqlite",
      "expo-splash-screen",
      "expo-asset",
      "expo-font"
    ]
  }
}
